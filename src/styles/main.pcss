	--lj-lightbox-backdrop: rgba(0, 0, 0, 0.95);
	--lj-c-danger: rgba(255, 107, 107, 0.88);
	--lj-c-danger-strong: rgba(255, 138, 138, 0.98);
	--lj-c-warning: #c88a11;
	--lj-c-success: #0b8f52;
