	--lj-b-on-accent-hover: rgba(255, 255, 255, 0.18);
	--lj-alpha-5-8: rgba(255, 255, 255, 0.08);
	--lj-surf-canvas: #030303;
	--lj-surf-canvas-alt: #050505;
	--lj-grad-from: rgba(0, 0, 0, 0.1);
	--lj-grad-to: rgba(0, 0, 0, 0.28);
	--lj-c-faint-dim: rgba(255, 255, 255, 0.1);
	--lj-c-strong-dim: rgba(255, 255, 255, 0.8);
	--lj-surf-tint-strong: rgba(255, 255, 255, 0.1);
	--lj-c-muted-mid: rgba(255, 255, 255, 0.42);
	--lj-c-on-accent: rgba(255, 255, 255, 0.28);
