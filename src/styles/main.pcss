	--lj-surf-danger-soft: rgba(255, 107, 107, 0.1);
	--lj-surf-warning-soft: rgba(245, 190, 59, 0.18);
	--lj-surf-success-soft: rgba(52, 211, 153, 0.16);
	--lj-c-tertiary-bright: rgba(255, 255, 255, 0.7);
	--lj-c-inv-disabled: rgba(0, 0, 0, 0.4);
	--lj-surf-popover: rgba(10, 10, 10, 0.95);
	--lj-surf-input: rgba(255, 255, 255, 0.03);
	--lj-surf-field: rgba(255, 255, 255, 0.04);
	--lj-surf-field-muted: rgba(255, 255, 255, 0.05);
	--lj-surf-card-muted: rgba(255, 255, 255, 0.06);
	--lj-surf-panel-subtle: rgba(255, 255, 255, 0.02);
