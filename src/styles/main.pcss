@layer theme, base, components, utilities;
@import 'tailwindcss/theme.css' layer(theme) prefix(lj);
/* Import utilities only so Tailwind Preflight stays disabled in Obsidian. */
@import 'tailwindcss/utilities.css' layer(utilities) prefix(lj) source(none) important;
@source '../../src';
@custom-variant dark (&:where(.theme-dark, .theme-dark *));

@theme {
	--font-sans:
		'Inter Variable',
		'Noto Sans SC Variable',
		'PingFang SC',
		'Hiragino Sans GB',
		'Microsoft YaHei',
		'Segoe UI Sans',
		ui-sans-serif,
		system-ui,
		sans-serif;
	--font-mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, monospace;
}

@theme inline {
	--color-lj-bg: var(--lj-bg);
	--color-lj-text: var(--lj-text);
	--color-lj-text-secondary: var(--lj-text-secondary);
	--color-lj-text-muted: var(--lj-text-muted);
