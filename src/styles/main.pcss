	--lj-c-muted-ghost: rgba(255, 255, 255, 0.3);
	--lj-alpha-10-5: rgba(255, 255, 255, 0.05);
	--lj-ring-emphasis: rgba(255, 255, 255, 0.2);
	--lj-shadow-subtle: rgba(255, 255, 255, 0.05);
