		--lj-c-strong: #111827;
		--lj-alpha-10: rgba(0, 0, 0, 0.1);
		--lj-c-muted: #6b7280;
		--lj-c-hint: #9ca3af;
		--lj-alpha-5: rgba(0, 0, 0, 0.05);
		--lj-c-secondary: #374151;
		--lj-c-tertiary: #4b5563;
		--lj-c-inv: #ffffff;
		--lj-alpha-5-10: rgba(0, 0, 0, 0.05);
		--lj-c-hint-vivid: #9ca3af;
		--lj-c-hint-dim: #9ca3af;
		--lj-alpha-20: rgba(0, 0, 0, 0.2);
