body {
	& .workspace-leaf.lucrjournal-dashboard-leaf .view-header {
		display: none;
	}

	& .workspace-leaf.lucrjournal-leaf .view-content {
		padding: 0;
	}

	& .metadata-property[data-property-key="lucr_type"].is-lucrjournal-readonly-property .metadata-property-key,
	& .metadata-property[data-property-key="lucr_type"].is-lucrjournal-readonly-property .metadata-property-value {
		pointer-events: none;
	}

	& .metadata-property[data-property-key="lucr_type"].is-lucrjournal-readonly-property .metadata-property-value {
		display: flex;
		align-items: center;
	}

	& .metadata-property[data-property-key="lucr_type"].is-lucrjournal-readonly-property .lucrjournal-lucr-type-icon {
		display: flex;
		color: var(--text-muted);
	}

	& .metadata-property[data-property-key="lucr_type"].is-lucrjournal-readonly-property .lucrjournal-lucr-type-icon > span {
		display: flex;
	}
}

.lj-scrollbar-hidden {
	-ms-overflow-style: none;
	scrollbar-width: none;
}

.lj-scrollbar-hidden::-webkit-scrollbar {
	display: none;
	inline-size: 0;
	block-size: 0;
}

.lucrjournal-view {
	padding: 16px;
	background-color: var(--lj-bg);
	block-size: 100%;
	overflow-y: auto;
	line-height: normal;
	color-scheme: dark;

	--lj-bg: #030303;
	--lj-text: #eaeaea;
	--lj-text-secondary: rgba(234, 234, 234, 0.7);
	--lj-text-muted: rgba(234, 234, 234, 0.4);
	--lj-text-faint: rgba(234, 234, 234, 0.2);
	--lj-border: rgba(255, 255, 255, 0.1);
	--lj-profit-text: #ffffff;
	--lj-loss-text: rgba(255, 255, 255, 0.3);
	--lj-circle-track: rgba(255, 255, 255, 0.05);
	--lj-circle-stroke: #ffffff;
	--lj-btn-bg: #ffffff;
	--lj-btn-text: #000000;
	--lj-btn-text-muted: rgba(0, 0, 0, 0.4);
	--lj-weekly-bg: #0a0a0a;
	--lj-calendar-grid-line: rgba(255, 255, 255, 0.04);
	--lj-calendar-header-bg: #0a0a0a;
	--lj-calendar-header-text: rgba(255, 255, 255, 0.3);
	--lj-calendar-cell-bg: #030303;
	--lj-calendar-cell-hover: rgba(255, 255, 255, 0.03);
	--lj-profit-dot: #ffffff;
	--lj-loss-dot: rgba(255, 255, 255, 0.2);
	--lj-pnl-loss: rgba(255, 255, 255, 0.3);
	--lj-playbook-border: rgba(255, 255, 255, 0.12);
	--lj-hover-bg: rgba(255, 255, 255, 0.05);
	--lj-c-strong: #ffffff;
	--lj-alpha-10: rgba(255, 255, 255, 0.1);
	--lj-c-muted: rgba(255, 255, 255, 0.4);
	--lj-c-hint: rgba(255, 255, 255, 0.3);
	--lj-alpha-5: rgba(255, 255, 255, 0.05);
	--lj-c-secondary: rgba(255, 255, 255, 0.7);
	--lj-c-tertiary: rgba(255, 255, 255, 0.6);
	--lj-c-inv: #000000;
	--lj-alpha-5-10: rgba(255, 255, 255, 0.1);
	--lj-c-hint-vivid: rgba(255, 255, 255, 0.4);
	--lj-c-hint-dim: rgba(255, 255, 255, 0.25);
	--lj-alpha-20: rgba(255, 255, 255, 0.2);
	--lj-c-muted-vivid: rgba(255, 255, 255, 0.45);
	--lj-surf: #0a0a0a;
