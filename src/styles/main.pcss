		--lj-surf-card-muted: #f3f4f6;
		--lj-surf-panel-subtle: rgba(249, 250, 251, 0.5);
		--lj-surf-panel: rgba(249, 250, 251, 0.7);
		--lj-surf-panel-faint: rgba(255, 255, 255, 0.5);
		--lj-surf-panel-soft: rgba(255, 255, 255, 0.8);
		--lj-surf-empty: rgba(255, 255, 255, 0.6);
		--lj-surf-button: #ffffff;
