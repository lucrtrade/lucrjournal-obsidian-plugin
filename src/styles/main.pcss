	--lj-c-muted-faint: rgba(255, 255, 255, 0.2);
	--lj-surf-deep: #0b0b0b;
	--lj-alpha-6: rgba(255, 255, 255, 0.06);
	--lj-c-strong-secondary: rgba(255, 255, 255, 0.7);
	--lj-c-tertiary-vivid: rgba(255, 255, 255, 0.65);
	--lj-b-gray: rgba(255, 255, 255, 0.1);
	--lj-surf-fill-dim: rgba(255, 255, 255, 0.05);
	--lj-c-on-fill: #ffffff;
	--lj-fill-contrast: #ffffff;
