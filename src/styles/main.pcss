	--lj-ring-faint: rgba(255, 255, 255, 0.1);
	--lj-alpha-inv-5: rgba(0, 0, 0, 0.05);
	--lj-fill-toggle: #e5e7eb;
	--lj-surf-alt: #111;
	--lj-c-muted-half: rgba(255, 255, 255, 0.5);
	--lj-c-strong-soft: rgba(255, 255, 255, 0.8);
