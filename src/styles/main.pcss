		--lj-surf-button-hover: rgba(0, 0, 0, 0.05);
		--lj-surf-button-hover-soft: rgba(0, 0, 0, 0.03);
		--lj-surf-button-hover-faint: rgba(0, 0, 0, 0.01);
		--lj-surf-segmented: rgba(0, 0, 0, 0.03);
		--lj-surf-segmented-active: rgba(0, 0, 0, 0.04);
		--lj-surf-segmented-muted: rgba(0, 0, 0, 0.015);
		--lj-overlay-border: rgba(255, 255, 255, 0.1);
		--lj-overlay-border-soft: rgba(255, 255, 255, 0.08);
		--lj-overlay-surface: rgba(0, 0, 0, 0.26);
		--lj-overlay-surface-soft: rgba(0, 0, 0, 0.24);
		--lj-overlay-surface-panel: rgba(0, 0, 0, 0.22);
		--lj-overlay-text: rgba(255, 255, 255, 0.8);
		--lj-overlay-text-soft: rgba(255, 255, 255, 0.74);
		--lj-overlay-text-muted: rgba(255, 255, 255, 0.75);
		--lj-overlay-text-dim: rgba(255, 255, 255, 0.4);
		--lj-overlay-text-strong: rgba(255, 255, 255, 0.92);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	:where(h1, h2, h3, h4, h5, h6) {
		display: block;
		margin: 0;
		border: 0;
		padding: 0;
		background: none;
		font: inherit;
		color: inherit;
		line-height: inherit;
	}

	:where(h1, h2, h3, h4, h5, h6)::before {
		content: none !important;
		display: none !important;
	}

	:is(.heading-collapse-indicator, .collapse-indicator) {
		display: none !important;
	}

	:where(input, textarea, select) {
		font: inherit;
		color: inherit;
		outline: none;
		box-shadow: none;
		-webkit-appearance: none;
		appearance: none;
	}

	:is(button, button:not(.clickable-icon)) {
		cursor: pointer;
		pointer-events: auto;
		margin: 0;
		border: 0;
		padding: 0;
		border-radius: 0;
		background: none;
		background-color: transparent;
		font: inherit;
		color: inherit;
		line-height: inherit;
		outline: none;
		box-shadow: none;
		-webkit-appearance: none;
		appearance: none;
	}

	input::placeholder {
		color: var(--lj-color-gray-500);
		opacity: 1;
	}

	table {
		border-collapse: collapse;
		border-spacing: 0;
	}

	:where(th, td) {
		padding: 0;
		border: 0;
		background: none;
		font-weight: inherit;
		text-align: start;
	}

	nav {
		display: flex;
		margin: 0;
		border: 0;
		padding: 0;
		background: none;
		font: inherit;
		color: inherit;
		line-height: inherit;
	}

	.lj-tab-nav {
		position: relative;
	}

	.lj-tab-indicator {
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		background: var(--lj-text);
		transition:
			transform 360ms cubic-bezier(0.16, 1, 0.3, 1) 70ms,
			width 360ms cubic-bezier(0.16, 1, 0.3, 1) 70ms,
			opacity 180ms ease;
		pointer-events: none;
	}

	.lj-modal-open & {
		overflow: hidden;
	}

	svg {
		display: inline-block;
		vertical-align: middle;
	}

	.lj-embedded-editor-content {
		block-size: 100%;
		inline-size: 100%;
		--file-margins: 16px;
		--view-top-spacing: 0px;
		--view-top-spacing-markdown: var(--file-margins);
	}

	.lj-embedded-editor-content.view-content {
		background-color: transparent !important;
		background-image: none !important;
	}

	.lj-embedded-editor-content :where(.inline-title, .inline-title-input, .inline-title-row) {
		display: none !important;
	}

	.lj-embedded-editor-content :where(.cm-contentContainer) {
		padding-block-start: 0;
	}

}

.lj-modal-surface-shadow {
	box-shadow: 0 20px 48px rgba(0, 0, 0, 0.14);
}

.lucrjournal-release-notes {
	max-height: min(70vh, 42rem);
	overflow-y: auto;
}

.lucrjournal-release-notes-footer {
	display: flex;
	justify-content: flex-end;
	margin-top: 1.5rem;
}

.lj-status-dot-highlight-glow {
	box-shadow: 0 0 8px rgba(17, 17, 17, 0.4);
}

.theme-dark .lj-status-dot-highlight-glow {
	box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
}

.lj-dashboard-floating-nav-shell {
	box-shadow: 0 0 40px rgba(0, 0, 0, 0.15);
}

.lj-dashboard-floating-nav-shell:hover {
	box-shadow: 0 0 60px rgba(0, 0, 0, 0.25);
}

.theme-dark .lj-dashboard-floating-nav-shell {
	box-shadow: 0 0 40px rgba(255, 255, 255, 0.15);
}

.theme-dark .lj-dashboard-floating-nav-shell:hover {
	box-shadow: 0 0 60px rgba(255, 255, 255, 0.25);
}

	.lj-dashboard-header-elevated {
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
	}

	.lj-calendar-grid-cell {
		box-shadow: inset -1px 0 0 var(--lj-calendar-grid-line), inset 0 -1px 0 var(--lj-calendar-grid-line);
	}

	.theme-dark .lj-dashboard-header-elevated {
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
	}

.lj-dashboard-playbook-card-shadow {
	box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
}

.lj-dashboard-playbook-card-shadow:hover {
	box-shadow: 0 18px 44px rgba(15, 23, 42, 0.08);
}

.theme-dark .lj-dashboard-playbook-card-shadow:hover {
	box-shadow: 0 18px 44px rgba(0, 0, 0, 0.35);
}

.lj-dashboard-meta-tab-shadow {
	box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
}

.lj-dashboard-hero-ring-glow {
	filter: drop-shadow(0 0 12px rgba(0, 0, 0, 0.3));
}

.theme-dark .lj-dashboard-hero-ring-glow {
	filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.3));
}

.lj-position-details-media-vignette {
	background: radial-gradient(circle at center, transparent 18%, rgba(255, 255, 255, 0.5) 100%);
}

.theme-dark .lj-position-details-media-vignette {
	background: radial-gradient(circle at center, transparent 18%, rgba(0, 0, 0, 0.42) 100%);
}

.lj-position-details-media-image-shadow {
	box-shadow: 0 24px 54px rgba(15, 23, 42, 0.18);
}

.theme-dark .lj-position-details-media-image-shadow {
	box-shadow: 0 28px 70px rgba(0, 0, 0, 0.42);
}

.lj-position-details-media-carousel {
	opacity: 1;
	visibility: visible;
	transform: translateY(0);
	transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
}

.lj-position-details-media-carousel-pill {
	min-height: 44px;
	border: 1px solid rgba(255, 255, 255, 0.06);
	border-radius: 999px;
	padding: 0 8px;
	background: rgba(10, 10, 10, 0.86);
	color: rgba(255, 255, 255, 0.94);
	backdrop-filter: blur(18px);
	box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
}

.lj-position-details-media-carousel-pill button {
	color: rgba(255, 255, 255, 0.72);
}

.lj-position-details-media-carousel-pill button:hover,
.lj-position-details-media-carousel-pill button:focus-visible {
	background: rgba(255, 255, 255, 0.08);
	color: rgba(255, 255, 255, 0.98);
}

.lj-position-details-media-carousel-counter {
	color: rgba(255, 255, 255, 0.84);
}

@media (hover: hover) and (pointer: fine) {
	.lj-position-details-media-carousel {
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
	}

	.lj\:group:hover .lj-position-details-media-carousel,
	.lj\:group:focus-within .lj-position-details-media-carousel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
}

.theme-dark .lj-position-details-media-carousel-pill {
	border-color: rgba(255, 255, 255, 0.08);
	background: rgba(5, 5, 5, 0.88);
	box-shadow: 0 22px 48px rgba(0, 0, 0, 0.42);
}

