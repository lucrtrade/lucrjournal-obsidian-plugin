	--lj-surf-panel-faint: rgba(255, 255, 255, 0.02);
	--lj-surf-panel-soft: rgba(255, 255, 255, 0.04);
	--lj-surf-empty: rgba(255, 255, 255, 0.03);
	--lj-surf-button: rgba(255, 255, 255, 0.04);
