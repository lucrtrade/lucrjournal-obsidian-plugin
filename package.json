{
	"name": "lucrjournal",
	"version": "0.1.10",
	"chart_version": "3.0",
	"description": "Record your trades as local Markdown files and link every entry to its key levels, confluences, market analysis, and news — turning your journal into a connected, private knowledge graph.",
	"main": "main.js",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"repository": "https://github.com/lucrtrade/lucrjournal-obsidian-plugin",
	"author": {
		"name": "LucrTrade",
		"email": "contact@lucrtrade.com",
		"url": "https://github.com/lucrtrade"
	},
	"scripts": {
		"prebuild": "bun run prebuild:icons",
		"prebuild:icons": "bun scripts/generate-icons.ts",
		"lint:unused": "bun scripts/check-unused-code.ts",
		"knip": "bunx --bun knip",
		"lint:deps": "bunx --bun depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src",
		"lint:tsc": "bunx --bun tsgo -noEmit -skipLibCheck",
		"lint:eslint": "bunx --bun eslint .",
		"css": "bunx --bun tailwindcss -i src/styles/main.pcss -o styles.css --minify && bun scripts/inline-fonts.ts",
		"css:dev": "bunx --bun tailwindcss -i src/styles/main.pcss -o styles.css --watch",
		"dev": "bun esbuild.config.ts development watch",
		"build:bundle": "bun run css && bunx --bun tsgo -noEmit -skipLibCheck && bun esbuild.config.ts development build",
		"build:bundle:prod": "bun run css && bunx --bun tsgo -noEmit -skipLibCheck && bun esbuild.config.ts production build",
		"build": "bun run build:bundle && bun scripts/sync-obsidian-local.ts",
		"build:prod": "bun run build:bundle:prod",
		"bundle:size": "bun scripts/update-bundle-size.ts",
		"install:vault": "bun run build:bundle && bun scripts/sync-obsidian-local.ts --install",
		"screenshots": "bun scripts/capture-obsidian-screenshots.ts",
		"ocr:assets": "bun scripts/sync-ocr-assets.ts",
		"ocr:assets:check": "bun scripts/sync-ocr-assets.ts --check",
		"ocr:test": "bun scripts/test-ocr-model.ts",
		"ocr:test:snapshots": "bun scripts/test-ocr-model.ts --write-snapshots --json",
		"ocr:test:verify": "bun scripts/test-ocr-model.ts --verify-snapshots --json",
		"test": "bunx --bun vitest run",
		"prepare": "bunx --bun husky",
		"version": "bun scripts/version-bump.ts && git add manifest.json versions.json",
		"lint": "bun run lint:tsc && bun run lint:eslint:fix && bun run knip && bun run lint:deps && bun run lint:doc-assets",
		"lint:eslint:fix": "bunx --bun eslint . --fix",
		"lint:doc-assets": "bun scripts/check-doc-assets.ts"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@eslint/json": "^2.0.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@tailwindcss/cli": "4.3.0",
		"@types/node": "25.9.1",
		"@types/react": "19.2.16",
		"@types/react-dom": "19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260601.1",
		"arktype": "2.2.0",
		"dependency-cruiser": "^17.4.3",
		"esbuild": "0.28.0",
		"eslint": "^10.4.1",
		"eslint-plugin-i18next": "6.1.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-obsidianmd": "0.3.0",
		"globals": "17.6.0",
		"husky": "^9.1.7",
		"jiti": "2.7.0",
		"knip": "^6.15.0",
		"onnxruntime-node": "^1.26.0",
		"ppu-ocv": "^3.2.2",
		"tailwindcss": "4.3.0",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.1",
		"vitest": "4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.2.8",
		"@fontsource-variable/jetbrains-mono": "5.2.8",
		"@fontsource-variable/noto-sans-sc": "5.2.10",
		"@tanstack/react-table": "8.21.3",
		"obsidian": "1.13.1",
		"onnxruntime-web": "^1.26.0",
		"ppu-paddle-ocr": "^5.8.3",
		"protobufjs": "8.5.0",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"overrides": {
		"protobufjs": "$protobufjs",
		"flatted": "3.4.2",
		"lodash": "4.18.1",
		"fast-uri": "3.1.2"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"esbuild",
		"onnxruntime-node",
		"protobufjs",
		"unrs-resolver"
	]
}