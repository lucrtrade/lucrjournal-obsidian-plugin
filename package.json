{
	"name": "lucrjournal",
	"version": "0.1.3",
	"chart_version": "1.1",
	"description": "Record your trades as local Markdown files and link every entry to its key levels, confluences, market analysis, and news — turning your journal into a connected, private knowledge graph.",
	"main": "main.js",
	"type": "module",
	"repository": "https://github.com/lucrtrade/lucrjournal-obsidian-plugin",
	"author": {
		"name": "LucrTrade",
		"email": "contact@lucrtrade.com",
		"url": "https://github.com/lucrtrade"
	},
	"scripts": {
		"prebuild": "npm run prebuild:icons",
		"prebuild:icons": "node scripts/generate-icons.mjs",
		"lint:unused": "node scripts/check-unused-code.mjs",
		"knip": "knip",
		"lint:deps": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src",
		"lint:tsc": "tsgo -noEmit -skipLibCheck",
		"lint:eslint": "eslint .",
		"css": "tailwindcss -i src/styles/main.css -o styles.css --minify && node scripts/inline-fonts.mjs",
		"css:dev": "tailwindcss -i src/styles/main.css -o styles.css --watch",
		"dev": "node esbuild.config.mjs development watch",
		"build:bundle": "npm run css && tsgo -noEmit -skipLibCheck && node esbuild.config.mjs development build",
		"build:bundle:prod": "npm run css && tsgo -noEmit -skipLibCheck && node esbuild.config.mjs production build",
		"build": "npm run build:bundle && node scripts/sync-obsidian-local.mjs && node scripts/open-obsidian.mjs",
		"build:prod": "npm run build:bundle:prod && node scripts/sync-obsidian-local.mjs && node scripts/open-obsidian.mjs",
		"bundle:size": "node scripts/update-bundle-size.mjs",
		"install:vault": "npm run build:bundle && node scripts/sync-obsidian-local.mjs --install && node scripts/open-obsidian.mjs",
		"screenshots": "node scripts/capture-obsidian-screenshots.mjs",
		"ocr:assets": "node scripts/sync-ocr-assets.mjs",
		"ocr:assets:check": "node scripts/sync-ocr-assets.mjs --check",
		"ocr:test": "node scripts/test-ocr-model.mjs",
		"ocr:test:snapshots": "node scripts/test-ocr-model.mjs --write-snapshots --json",
		"ocr:test:verify": "node scripts/test-ocr-model.mjs --verify-snapshots --json",
		"test": "vitest run",
		"prepare": "husky",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json package-lock.json",
		"lint": "npm run lint:tsc && npm run lint:eslint:fix && npm run knip && npm run lint:deps",
		"lint:eslint:fix": "eslint . --fix"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@eslint/json": "^2.0.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@tailwindcss/cli": "4.3.0",
		"@types/node": "25.9.1",
		"@types/react": "19.2.16",
		"@types/react-dom": "19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260601.1",
		"arktype": "2.2.0",
		"dependency-cruiser": "^17.4.3",
		"esbuild": "0.28.0",
		"eslint": "^10.4.1",
		"eslint-plugin-i18next": "6.1.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-obsidianmd": "0.3.0",
		"globals": "17.6.0",
		"husky": "^9.1.7",
		"jiti": "2.7.0",
		"knip": "^6.15.0",
		"onnxruntime-node": "^1.26.0",
		"ppu-ocv": "^3.2.2",
		"tailwindcss": "4.3.0",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.1",
		"vitest": "4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.2.8",
		"@fontsource-variable/jetbrains-mono": "5.2.8",
		"@fontsource-variable/noto-sans-sc": "5.2.10",
		"@tanstack/react-table": "8.21.3",
		"obsidian": "1.13.0",
		"onnxruntime-web": "^1.26.0",
		"ppu-paddle-ocr": "^5.8.3",
		"protobufjs": "8.5.0",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"overrides": {
		"protobufjs": "$protobufjs"
	}
}