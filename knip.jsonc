{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// @story [[lucrjournal/tooling#^knip-project-scope]] Defines Knip entry roots project scope and reviewed exceptions
	"entry": [
		"src/main.ts",
		"src/styles/main.pcss",
		"scripts/*.ts"
	],
	"project": [
		"src/**/*.{ts,tsx}",
		"scripts/**/*.ts",
		"eslint-rules/**/*.ts",
		"test/**/*.js",
		"*.config.{ts,mts}"
	],
	"ignoreDependencies": [
		"@fontsource-variable/inter",
		"@fontsource-variable/jetbrains-mono",
		"@fontsource-variable/noto-sans-sc",
		"tailwindcss",
		"protobufjs"
	],
	"ignoreIssues": {
		"src/charts/lucrchart-host.ts": [
			"types"
		],
		"test/mocks/obsidian.js": [
			"unlisted"
		]
	},
	"tags": [
		"-knipignore"
	]
}
